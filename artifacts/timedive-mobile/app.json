{
  "expo": {
    "name": "TimeDive Mobile",
    "slug": "timedive-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "timedive-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06112D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mytimedive.app"
    },
    "android": {
      "package": "com.mytimedive.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1A56DB"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mytimedive.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "58b99c89-7225-4d86-92d7-4513bc91817b"
      }
    },
    "owner": "timedive"
  }
}
