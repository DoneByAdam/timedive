# Copy this to Railway's service Variables tab (not to a committed .env file).

# Postgres connection string from Neon (Dashboard > your project > Connection Details).
# Use the "pooled connection" string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Any long random string — signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Claude API key for story generation (routes/stories.ts).
ANTHROPIC_API_KEY=

# Public URL of the deployed app, used in emails (e.g. password reset links).
# Set this after your first deploy once you know the Railway/custom domain.
APP_URL=https://your-app.up.railway.app

# Optional — email sending; without it, emails just log to console.
RESEND_API_KEY=

NODE_ENV=production

# PORT is injected automatically by Railway at runtime — do not set manually.
